# Postgres connection string. For local dev with docker-compose:
DATABASE_URL="postgres://heights:heights@localhost:5432/heights_sales"

# LeafLink API credentials — get your key from LeafLink account settings > API.
LEAFLINK_API_KEY="your-leaflink-api-key"

# LeafLink API base URL. Production is app.leaflink.com; LeafLink also runs a
# sandbox environment at a separate domain if your account has one.
LEAFLINK_BASE_URL="https://app.leaflink.com/api/v2"

# LeafLink accepts two auth schemes depending on the kind of key you generated:
#   "Token" - personal API key (Authorization: Token <key>)
#   "App"   - application API key (Authorization: App <key>)
# If syncing fails with a 401/403, try switching this value.
LEAFLINK_AUTH_SCHEME="Token"

# Order statuses (comma-separated, must match LeafLink's status strings) that
# count as real sales in the dashboards. Adjust to taste.
LEAFLINK_COUNTED_STATUSES="Submitted,Accepted,Fulfilled,Completed"
